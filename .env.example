# Backend environment variables; set in shell before starting. No automatic dotenv loading.
LOADBOND_DATA=data
# Replace before any network deployment. One token maps to one isolated demo workspace.
LOADBOND_TOKENS={"replace-with-random-token":"workspace-one"}
# This workbench uses local Ollama only. No cloud inference fallback.
# Frontend server only:
LOADBOND_API_URL=http://127.0.0.1:8000
LOADBOND_LOCAL_MODEL=qwen3:4b
LOADBOND_OLLAMA_URL=http://127.0.0.1:11434
